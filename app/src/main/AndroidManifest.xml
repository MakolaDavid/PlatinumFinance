<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network permissions for REST API and offline sync connectivity checks -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permission required for Real-Time Push Notifications on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PlatinumFinance"
        android:usesCleartextTraffic="true">

        <!-- 1. Authentication Hub launches first (Register, Login, & SSO) -->
        <activity
            android:name=".RegisterActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Main Dashboard (Offline RoomDB & Sync) -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- 3. User Settings & Multi-Language Screen (English, Sesotho, isiZulu) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".NoSqlVaultActivity"
            android:exported="false" />

    </application>

</manifest>