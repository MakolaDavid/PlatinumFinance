<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    tools:ignore="HardcodedText">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/new_transaction"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etTransactionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/hint_title"
        android:inputType="text"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etTransactionAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:hint="@string/hint_amount"
        android:inputType="numberDecimal"
        android:layout_marginBottom="16dp"/>

    <!-- Button 1: Save Transaction Offline to RoomDB -->
    <Button
        android:id="@+id/btnSaveTransaction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/btn_save_offline"
        android:layout_marginBottom="8dp"/>

    <!-- Button 2: Open User Settings & South African Language Switcher -->
    <Button
        android:id="@+id/btnOpenSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="@string/btn_open_settings"
        android:layout_marginBottom="8dp"/>

    <!-- Button 3: Synchronize Offline RoomDB Records When Reconnected -->
    <Button
        android:id="@+id/btnSyncData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Sync Offline Data to Cloud"
        android:layout_marginBottom="8dp"/>

    <!-- Button 4: Open NoSQL Database & Blob Storage Vault -->
    <Button
        android:id="@+id/btnOpenVault"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:text="Open NoSQL &amp; Blob Receipt Vault"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/offline_history"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <TextView
            android:id="@+id/tvTransactionHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_transactions"
            android:textSize="16sp"/>
    </ScrollView>
</LinearLayout>